# 仅为配置示例。程序读取进程环境变量，不会自动加载本文件。
# 在本机终端 export DEEPSEEK_API_KEY=...，不要把真实密钥提交到 Git。
DEEPSEEK_API_KEY=
# 地址和模型标识填写主办方提供的值；下面只保留下发基线默认值。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RUNBOOK_LLM_TIMEOUT=60
RUNBOOK_MAX_LLM_CALLS=9
RUNBOOK_MAX_OUTPUT_TOKENS=1024
# 输出列保护候选，默认关闭；仅在明确的单因素对照中启用。
RUNBOOK_PRESERVE_TEMPLATE_COLUMNS=0
# 企业代理需要自定义 CA 时设置可信证书文件，保持 TLS 校验。
# SSL_CERT_FILE=/absolute/path/to/trusted-ca.pem
