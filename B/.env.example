# 仅为配置示例。程序读取进程环境变量，不会自动加载本文件。
# 在本机终端 export DEEPSEEK_API_KEY=...，不要把真实密钥提交到 Git。
DEEPSEEK_API_KEY=
# 地址和模型标识填写主办方提供的值；下面只保留下发基线默认值。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RUNBOOK_LLM_TIMEOUT=60
RUNBOOK_MAX_LLM_CALLS=9
RUNBOOK_MAX_OUTPUT_TOKENS=1024
# 输出列保护候选，默认关闭；仅在明确的单因素对照中启用。
RUNBOOK_PRESERVE_TEMPLATE_COLUMNS=0
# 通用跨步依赖检查候选，默认关闭；空参考结果的拒答存在失分风险。
RUNBOOK_VALIDATE_API_DEPENDENCIES=0
# 全部占位符均有明确规则值时省略模型填参；默认关闭，SQL 精调保留。
RUNBOOK_RULE_ONLY_FILL=0
# 有界 GET 分批与空依赖停止实验；默认关闭，尚未做真实模型全量回归。
RUNBOOK_BOUNDED_API=0
# 精调去重、计数口径、明细分组保护；默认关闭，等待完整回放和真实配对。
RUNBOOK_PRESERVE_ROW_SEMANTICS=0
# schema + 实际投影证明的资源属性角色（当前 hostClass 分类短语）；默认关闭。
RUNBOOK_RESOURCE_ATTRIBUTE_ROLES=0
# 企业代理需要自定义 CA 时设置可信证书文件，保持 TLS 校验。
# SSL_CERT_FILE=/absolute/path/to/trusted-ca.pem

# v2本地实验候选：默认关闭；真实训练需冻结计划和单独预算。
RUNBOOK_PRESERVE_AGGREGATE_GRAIN=0
RUNBOOK_PRESERVE_LITERAL_LABELS=0
RUNBOOK_PRUNE_UNUSED_LOOKUPS=0
RUNBOOK_GROUND_ENUM_LABELS=0
# v3 SQL输出合同提示词，仅16训练题真实配对验证，默认关闭。
RUNBOOK_REFINE_CONTRACT_PROMPT=0
