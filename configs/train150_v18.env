# B v18 fixed train150 runtime configuration; no credentials.
# Explicitly load in a shell for ordinary C entrypoints; files are not auto-loaded.
# train_live.py uses CLI flags and may override exported values; follow C_RETEST_PROTOCOL_V18.md.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
RUNBOOK_MAX_LLM_CALLS=450
RUNBOOK_MAX_OUTPUT_TOKENS=1024
RUNBOOK_PRESERVE_TEMPLATE_COLUMNS=1
RUNBOOK_RULE_ONLY_FILL=1
RUNBOOK_PRESERVE_ROW_SEMANTICS=1
RUNBOOK_RESOURCE_ATTRIBUTE_ROLES=1
RUNBOOK_VALIDATE_API_DEPENDENCIES=0
RUNBOOK_BOUNDED_API=0
RUNBOOK_PRESERVE_AGGREGATE_GRAIN=1
RUNBOOK_PRESERVE_LITERAL_LABELS=1
RUNBOOK_PRUNE_UNUSED_LOOKUPS=1
RUNBOOK_GROUND_ENUM_LABELS=1
RUNBOOK_REFINE_CONTRACT_PROMPT=1
RUNBOOK_COMPLETE_INDEPENDENT_AGGREGATES=1
RUNBOOK_COMPLETE_GROUPED_AGGREGATES=1
RUNBOOK_COMPLETE_NETWORK_DETAILS=1
RUNBOOK_COMPLETE_IDENTITY_PROJECTION=1
RUNBOOK_COMPLETE_VPC_SUBNETS=1
RUNBOOK_COMPLETE_TENANT_RESOURCES=1
RUNBOOK_COMPLETE_VM_VOLUME_DETAILS=1
RUNBOOK_BIND_TENANT_VDC=1
RUNBOOK_COMPLETE_PARALLEL_LISTS=1
RUNBOOK_THINKING_MODE=disabled
