      "question": "ECS实例cse-engine-cluster-roma-guian-4-3-master-1当前是什么状态，其规格配置是什么？",
      "query_method": "查 `CLOUD_VM_NOVA WHERE name=cse-engine-cluster-roma-guian-4-3-master-1` 获取 status、flavorId → `CLOUD_FLAVOR WHERE id=flavorId` 获取 vcpuSize、ramSize、diskSize",
      "api_call": [
        {
          "method": "GET",
          "url": "/rest/hackthon/db/instances/VM_NOVA?pageNo=1&pageSize=10000",
          "condition": {
            "constraint": [
              {
                "simple": {
                  "name": "name",
                  "value": "cse-engine-cluster-roma-guian-4-3-master-1",
                  "operator": "equal"
                }
              }
            ]
          }
        },
        {
          "method": "GET",
          "url": "/rest/hackthon/db/instances/FLAVOR?pageNo=1&pageSize=10000",
          "condition": {
            "constraint": [
              {
                "simple": {
                  "name": "id",
                  "value": "{{flavorId from step 1}}",
                  "operator": "equal"
                }
              }
            ]
          },
          "autoPagination": true,
          "totalNum": 15406,
          "totalPages": 2
        }
      ],
      "sql": "SELECT CLOUD_VM_NOVA.name AS vm_name, CLOUD_VM_NOVA.status, CLOUD_FLAVOR.vcpuSize, CLOUD_FLAVOR.ramSize, CLOUD_FLAVOR.diskSize FROM CLOUD_VM_NOVA INNER JOIN CLOUD_FLAVOR ON CLOUD_VM_NOVA.flavorId = CLOUD_FLAVOR.id",
      "answer": {
