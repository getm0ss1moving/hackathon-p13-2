+def normalize_bootable(value):
+    """Model input only -> native lowercase string; no truthiness/numeric coercion."""
+    if type(value) is bool:
+        return 'true' if value else 'false'
+    if type(value) is str and value.lower() in {'true', 'false'}:
+        return value.lower()
+    raise ValueError('bootable_boolean_or_true_false_string_required')
+
+
+def _normalize_bootable_parameters(parsed):
+    if (isinstance(parsed, dict) and parsed.get('view') == 'bootable_scoped_rows'
+            and isinstance(parsed.get('filters'), dict) and 'bootable' in parsed['filters']):
+        parsed = copy.deepcopy(parsed)
+        parsed['filters']['bootable'] = normalize_bootable(parsed['filters']['bootable'])
+    return parsed
+
