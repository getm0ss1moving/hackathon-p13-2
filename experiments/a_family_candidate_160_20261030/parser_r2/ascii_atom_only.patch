+def _inside_ascii_atom(span, atoms):
+    # A role/keyword starting inside a continuous identifier is entity text.
+    # A role at the next atom's start can still introduce a real condition;
+    # a prefix at the value's own start is already kept by _filters.
+    return any(a < span[0] and span[1] <= b
+               for a, b in atoms)
 
 
