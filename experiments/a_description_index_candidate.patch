+def _description_for_index(item: dict) -> str:
+    """按API参数契约泛化描述，原示例继续保留实体词汇。"""
+    text = item.get("description") or ""
+    defaults = item.get("default_params") or {}
+    if not isinstance(defaults, dict):
+        return text
+    api = item.get("api_call") or []
+    calls = api if isinstance(api, list) else [api]
+    replacements = {}
+    ambiguous = set()
+    for call in calls:
+        if not isinstance(call, dict):
+            continue
+        condition = call.get("condition") or {}
+        if not isinstance(condition, dict):
+            continue
+        for constraint in condition.get("constraint") or []:
+            simple = constraint.get("simple") if isinstance(constraint, dict) else None
+            if not isinstance(simple, dict) or not isinstance(simple.get("name"), str):
+                continue
+            parameter = _PARAMETER_VALUE.fullmatch(str(simple.get("value", "")))
+            if not parameter or not _IDENTIFIER_FIELD.search(simple.get("name", "")):
+                continue
+            key = parameter.group(1)
+            value = defaults.get(key)
+            if (isinstance(value, str) and value.isascii()
+                    and _ENTITY_SEPARATOR.search(value)):
+                placeholder = "{{" + key + "}}"
+                if value in replacements and replacements[value] != placeholder:
+                    ambiguous.add(value)
+                replacements[value] = placeholder
+    for value in sorted(replacements, key=len, reverse=True):
+        if value in ambiguous:
+            continue
+        pattern = (r"(?<![a-zA-Z_0-9.@#\-])([A-Z]{2,})?" + re.escape(value)
+                   + r"(?![a-zA-Z_0-9.@#\-])")
+        text = re.sub(pattern, lambda m: (m.group(1) or "") + replacements[value], text)
+    return text
+
+
