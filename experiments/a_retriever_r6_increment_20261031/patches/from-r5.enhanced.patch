+def _trimmed_query_part(query, start, end):
+    # Python str offsets: trim only at this original interval's boundaries.
+    # isspace() agrees with str.strip(); internal characters stay untouched.
+    while start < end and query[start].isspace():start += 1
+    while end > start and query[end - 1].isspace():end -= 1
+    return start, end, query[start:end]
