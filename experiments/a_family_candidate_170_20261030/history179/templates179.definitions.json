        "family_id": "F14",
        "name": "云硬盘VDC容量统计",
        "description": "指定区域各VDC的云硬盘数量及总容量，或平均及最大容量。",
        "resources": [
          "VOLUME"
        ],
        "examples": [
          "指定区域各VDC的云硬盘数量及总容量，或平均及最大容量。"
        ],
        "api_call": {
          "method": "GET",
          "url": "/rest/hackthon/db/instances/VOLUME?pageNo=1&pageSize=10000",
          "condition": {
            "constraint": [
              {
                "simple": {
                  "name": "logicalRegionName",
                  "value": "{{logicalRegionName}}",
                  "operator": "equal"
                }
              }
            ]
