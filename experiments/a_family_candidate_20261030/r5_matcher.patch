+            if not forced:
+                raise ValueError("ambiguous_role_binding:" + fields[key])
+            node = min(forced)
+            selected[node] = remaining[node][0]
+            used.append(selected[node][2])
+            pending.remove(node)
+        resolved.update(selected)
+        return resolved[key]
